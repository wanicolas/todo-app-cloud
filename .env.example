# Database (MySQL - used in Docker Compose)
MYSQL_HOST=mysql
MYSQL_USER=root
MYSQL_PASSWORD=secret
MYSQL_DB=todos



# Auth microservice — its own MySQL database
# (the auth service connects to a separate MySQL instance: mysql-auth / db "auth")

# JWT — shared secret used by the auth service to sign tokens and by the
# backend to verify them (HS256). Use a long random value in production.
JWT_SECRET=dev-insecure-secret
JWT_EXPIRES_IN=1h

# Node
NODE_ENV=development
